{
  "name": "studyapp",
  "version": "1.0.0",
  "description": "A modern Electron + React app",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "kill-port": "node scripts/kill-port.js 5173",
    "electron:dev": "npm run kill-port && concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "npm run electron:dev",
    "server": "node server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\""
  },
  "keywords": [
    "electron",
    "react",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@supabase/supabase-js": "^2.39.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "framer-motion": "^12.23.26",
    "helmet": "^7.2.0",
    "lucide-react": "^0.562.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "react": "^18.2.0",
    "react-activity-calendar": "^3.0.5",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.12.0",
    "react-webcam": "^7.2.0",
    "stripe": "^20.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.2",
    "electron": "^39.2.7",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.1",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0"
  }
}
