    "@tensorflow/tfjs-backend-webgl": "^4.22.0",
    "buffer": "^6.0.3",
    "framer-motion": "^12.23.26",
    "lucide-react": "^0.562.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.449",
