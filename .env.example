# MindFlow environment template.
#
# Copy to .env and fill in real values. .env is gitignored; never commit it.
#   cp .env.example .env
#
# Two processes read this file: the Vite dev server (VITE_* only) and the
# Express API (`npm run server`). Both fail hard on startup if a required
# variable is missing, so a typo here surfaces immediately rather than at
# request time.


# ---------------------------------------------------------------------------
# Express API server  -  required, `npm run server` exits(1) without these
# ---------------------------------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Either SUPABASE_URL or VITE_SUPABASE_URL satisfies the server; it checks both.
SUPABASE_URL=


# ---------------------------------------------------------------------------
# Express API server  -  optional / conditional
# ---------------------------------------------------------------------------

# Required when NODE_ENV=production. Without it the /webhook route cannot
# verify Stripe signatures. Local dev only needs it if you're testing webhooks
# through the Stripe CLI.
STRIPE_WEBHOOK_SECRET=

# Where Stripe returns the user after checkout and the billing portal.
# DEFAULTS TO http://localhost:5173 - set this in every deployed environment
# or paying customers get redirected to localhost after they pay. The server
# only warns about this, it does not refuse to start.
APP_BASE_URL=

# Comma-separated list of frontend origins allowed to call the API. Include
# every domain the app is served from, including the www variant if you use it:
#   ALLOWED_ORIGINS=https://mind-flow-two-dusky.vercel.app
# When unset the server falls back to the original hardcoded Vercel origin and
# warns at startup, so an existing deployment keeps working.
ALLOWED_ORIGINS=

# Your Vercel team or username slug - the last segment of a preview URL, e.g.
# the "acme" in mind-flow-git-main-acme.vercel.app. Setting it allows preview
# deployments through CORS. Leave it blank and previews are blocked, which is
# the safe default: matching on the project prefix instead would let anyone
# who names a project "mind-flow-..." reach this API with credentials.
VERCEL_PREVIEW_SCOPE=

# Defaults to 3000.
PORT=

# development | production. Gates debug logging and the production-only checks.
NODE_ENV=development


# ---------------------------------------------------------------------------
# Frontend (Vite)  -  all required in a production build
# ---------------------------------------------------------------------------
# Everything with a VITE_ prefix is bundled into the client JavaScript and is
# publicly readable. Only put publishable/anon keys here - never a secret key.
# src/config/api.js throws at module load in production if any are missing.

VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PRICE_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the Express API. No default - there is no correct guess for the
# backend host, so production builds refuse to start without it.
VITE_API_BASE_URL=

# Optional label used for environment display only.
VITE_ENV=

# Canonical public URL of the site, no trailing slash, used to build absolute
# og:image / og:url tags at build time. Open Graph scrapers will not resolve a
# relative image path, so this must match the domain you actually serve from or
# link previews render without an image.
# Defaults to the deployed Vercel URL when unset; set it if you move to a
# custom domain.
VITE_PUBLIC_SITE_URL=


# ---------------------------------------------------------------------------
# Supabase Edge Functions  -  NOT read from this file
# ---------------------------------------------------------------------------
# These are Deno secrets set in the Supabase dashboard (or via
# `supabase secrets set`). Listed here only so the full set is discoverable.
#
#   stripe-webhook            STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
#                             SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#   create-checkout-session   STRIPE_SECRET_KEY, STRIPE_PRICE_ID
#   gemini-chat               SUPABASE_URL, SUPABASE_ANON_KEY,
#                             SUPABASE_SERVICE_ROLE_KEY, gemini_key
#
# gemini-chat is the only AI path. It serves both the browser (via
# src/utils/gemini.js) and the Express server (via services/flashcardGenerator,
# which posts to /functions/v1/gemini-chat rather than calling Gemini itself).
# So lowercase `gemini_key` is the secret that matters.
#
# generate-flashcards is also deployed but nothing invokes it - no reference
# exists in src/, server.js or services/. It reads GEMINI_API_KEY, which is
# therefore not required. Delete the function or wire it up; leaving it
# deployed and unreferenced is how the "which key name?" confusion started.
